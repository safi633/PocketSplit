{
  "name": "pocketsplit",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "vite --config frontend/vite.config.mjs --host 0.0.0.0",
    "build:frontend": "vite build --config frontend/vite.config.mjs",
    "start:frontend": "serve frontend/dist",
    "start": "npm --prefix backend start",
    "test": "npm --prefix backend test",
    "check": "npm --prefix backend run check"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "serve": "^14.2.4",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
